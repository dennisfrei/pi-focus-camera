# Prime Focus Camera — backend configuration.
# Copy to `backend/.env` (the backend reads it from its working directory) or export the
# variables in the environment. All settings are optional; these are the defaults.
# Full reference: MANUAL.md § Configuration.

# Bind address/port for the Litestar app.
PFC_HOST=0.0.0.0
PFC_PORT=8080

# Use the mock camera even when picamera2 is importable (dev on a Pi, demos).
PFC_FORCE_MOCK=false

# Allow the UI to shut down / reboot the host. Off by default; install.sh turns it on for the Pi
# (and adds the sudoers rule the shutdown/reboot commands need).
PFC_ENABLE_POWER_CONTROLS=false

# Where captured images land (JPEG/raw/thumbnails). Point at a USB drive for real sessions.
PFC_CAPTURES_DIR=captures

# SQLite database (presets + capture metadata).
PFC_DB_PATH=astrocam.db

# Preview stream resolution for the real camera.
PFC_PREVIEW_WIDTH=1280
PFC_PREVIEW_HEIGHT=720

# How often focus/histogram metrics are recomputed (Hz). Lower this on a struggling Pi.
PFC_FOCUS_HZ=5.0

# Mock camera characteristics (dev only).
PFC_MOCK_WIDTH=1280
PFC_MOCK_HEIGHT=720
PFC_MOCK_FPS=15
