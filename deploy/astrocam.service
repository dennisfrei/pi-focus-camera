[Unit]
Description=Prime Focus Camera
# Wait for the network (the AP) to be up before binding.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __USER__ and __APP_DIR__ are filled in by deploy/install.sh from the actual checkout.
User=__USER__
WorkingDirectory=__APP_DIR__/backend
# Enable the in-app shutdown/reboot buttons (install.sh adds the matching sudoers rule).
Environment=PFC_ENABLE_POWER_CONTROLS=true
ExecStart=__APP_DIR__/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
